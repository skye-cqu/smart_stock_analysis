# ──────────────────────────────────────────────────────────────────────────────
# smart_stock_analysis — Environment Variables
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose which LLM provider to use: deepseek | gemini | ollama
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek/deepseek-chat

# DeepSeek API (primary — best Chinese financial understanding)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here         # (required) Get from platform.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com          # (optional)

# Google Gemini (alternative — good multilingual)
GEMINI_API_KEY=your-gemini-key-here                  # (optional) Get from aistudio.google.com

# Ollama (local — no API key needed, run `ollama serve` first)
OLLAMA_BASE_URL=http://localhost:11434               # (optional)
OLLAMA_MODEL=qwen2.5:14b                             # (optional) Any Ollama model

# ── Data Sources ──────────────────────────────────────────────────────────────
# AkShare is primary (free, no token). Tushare Pro is fallback.
TUSHARE_TOKEN=your-tushare-pro-token                 # (optional) Get from tushare.pro

# ── Notifications ─────────────────────────────────────────────────────────────
# Feishu bot webhook for pushing analysis results
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx  # (optional)

# ── Storage ───────────────────────────────────────────────────────────────────
SQLITE_DB_PATH=data/sqlite/stock.db                  # (optional)

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                                       # (optional) DEBUG | INFO | WARNING | ERROR
ANALYSIS_MAX_CONCURRENCY=5                           # (optional) Max parallel stock analyses
CACHE_TTL_MINUTES=5                                  # (optional) Market data cache TTL in minutes
